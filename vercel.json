{
  "installCommand": "npm install --legacy-peer-deps --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/admin-dashboard" }
    }
  ],

  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
